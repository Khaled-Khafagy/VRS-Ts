{
  "name": "vrs-ts",
  "version": "1.0.0",
  "description": "End-to-end automation testing framework built with Playwright and TypeScript, focusing on scalable UI and API testing.",
  "main": "index.js",
  "scripts": {
    "test:allure": "rm -rf allure-results && npx playwright test && npx allure serve allure-results",
    "test:headless": "rm -rf allure-results && CI=true npx playwright test && npx allure generate allure-results --clean -o allure-report && npx allure open allure-report",
    "test:regression": "npx playwright test tests/website/Regression",
    "test:sanity": "npx playwright test tests/website/Sanity",
    "test:p1": "npx playwright test --grep @P1",
    "test:p2": "npx playwright test --grep @P2",
    "report:exit": "ts-node scripts/generateExitReport.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USERNAME/VRS-Ts.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/mcp": "^0.0.70",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0",
    "axios": "^1.15.0",
    "dotenv": "^17.4.0",
    "joi": "^18.1.2",
    "pino": "^10.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "uuid": "^14.0.0",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "googleapis": "^172.0.0",
    "playwright": "^1.60.0"
  }
}
